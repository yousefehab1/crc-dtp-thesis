# ── Downloaded TCGA/GEO data (large, reproducible via pipeline) ───────────────
GDCdata/
cache/

# ── Pipeline output runs ───────────────────────────────────────────────────────
CRC_DTP_*/
CRC_Dipci_*/
archive/
/results/

# ── Superseded curated figures (the live copies are tracked; git history keeps
