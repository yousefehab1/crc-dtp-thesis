**/STALE_pre_*/

# ── Thesis writing (large binaries; the .md drafts stay tracked) ───────────────
*.docx
/Elabd_MSc_Thesis_draft.pdf
writing/*.pdf

# ── Large intermediate R objects ───────────────────────────────────────────────
*.rds
*.RData
*.rda

# ── R / RStudio ────────────────────────────────────────────────────────────────
.Rhistory
.RData
.Ruserdata
*.Rproj.user/
**/.Rproj.user/

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store

# ── Misc ──────────────────────────────────────────────────────────────────────
MANIFEST.txt
Rplots.pdf
~$*
.Rapp.history
**/.Rapp.history
